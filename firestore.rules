rules_version = '2';

// Reglas de seguridad de Firestore.
//
// Son la ÚNICA frontera real de este sistema: la app es un cliente que habla directo con
// Firestore, así que cualquiera puede saltearse el código del navegador y pegarle a la base por
// su cuenta. Lo que no esté permitido acá, no pasa.
//
// Ojo con lo que más se olvida: las reglas NO se heredan a las subcolecciones. Un
// `match /users/{userId}` cubre ese documento y nada más. Cada subcolección nueva necesita su
// propio bloque, o queda denegada (que es el default, y se nota como una función que "no anda"
// sin ningún error visible).
//
// Para desplegarlas: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // Este archivo es lo que tiene que estar publicado HOY. Si se edita, se publica
    // (`firebase deploy --only firestore:rules`): una regla que vive sólo en el repositorio no
    // protege nada, y una que se publica antes de tiempo deja a todos afuera.
    //
    // El segundo factor todavía NO se exige acá a propósito. La marca `mfaHasta` la pone el
    // servidor en el token al verificar el código por mail, y hasta que el circuito no esté
    // configurado y probado en producción (RESEND_API_KEY, RESEND_FROM, MFA_PEPPER) ningún token
    // la tiene: pedirla ahora denegaría todo, incluido el acceso del dueño. El cambio exacto para
    // cuando se active está en docs/REGLAS-FIRESTORE.md.
    function esElDueno(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Un usuario de la empresa. El `empresaId` lo escribe el servidor como custom claim al
    // aceptar la invitación (ver api/empresa.js): viaja firmado adentro del token y el navegador
    // no lo puede tocar. Acá está la diferencia entre un permiso y un cartelito.
    function esMiembro(userId) {
      return request.auth != null && request.auth.token.empresaId == userId;
    }

    // Qué bloques le tocan, también calculado por el servidor a partir de sus módulos. Se mira la
    // lista del token y no la de ningún documento, porque un documento se puede llegar a escribir
    // y el token no.
    function tieneBloque(bloque) {
      return request.auth.token.bloques is list && bloque in request.auth.token.bloques;
    }

    // El documento principal de la cuenta: SOLO el dueño, ni siquiera sus empleados.
    //
    // No es por prudencia de más. Acá quedó el `negocioData` entero de antes de partirlo en
    // bloques, que se dejó a propósito como respaldo (ver migrarABloques): si un empleado pudiera
    // leer este documento, se llevaría esa copia completa —sueldos incluidos— y todo el trabajo de
    // partir los datos no habría servido de nada. Lo que un empleado necesita vive en `datos`.
    //
    // Al exigir que el uid del token coincida con el del documento, una consulta a toda la
    // colección tampoco puede probar que cumple la regla, así que listar usuarios queda denegado
    // de entrada.
    match /users/{userId} {
      allow read, write: if esElDueno(userId);

      // Plan contratado y datos fiscales del emisor: el dueño los lee, pero solo el servidor
      // (Admin SDK, que no pasa por estas reglas) los escribe. Si el navegador pudiera tocarlos,
      // cualquiera se asignaría el plan Full, o se pondría el emisor de otro contribuyente para
      // facturar con un CUIT ajeno.
      match /meta/{documento} {
        // Del plan depende qué módulos existen, y el empleado usa el de la empresa porque plan
        // propio no tiene. Se le abre ese documento y nada más: `fiscal` tiene el emisor con el
        // que se factura, que no es asunto de un empleado.
        allow read: if esElDueno(userId) || (esMiembro(userId) && documento == 'plan');
        allow write: if false;
      }

      // El negocio, partido en bloques (ver src/lib/permisos.ts). Acá es donde el permiso por
      // módulo se vuelve real: el dueño ve los cinco, y cada empleado solo los que le tocan según
      // los módulos que le asignaron. Partirlo es lo que hace posible esta regla — con todo en un
      // documento, dar acceso a las facturas era dar acceso a los sueldos.
      match /datos/{bloque} {
        allow read, write: if esElDueno(userId) || (esMiembro(userId) && tieneBloque(bloque));
      }

      // Copias diarias automáticas del negocio (ver guardarBackupAutomaticoSiHaceFalta): las
      // escribe y las lee el propio dueño, igual que sus datos.
      match /backups/{backupId} {
        allow read, write: if esElDueno(userId);
      }

      // Respaldo de cada emisión con su CAE, que guarda el servidor al emitir. Es un registro
      // fiscal: el dueño puede consultarlo, pero no falsearlo ni borrarlo.
      match /emisiones/{referenciaExterna} {
        allow read: if esElDueno(userId);
        allow write: if false;
      }

      // Quiénes son los usuarios de la empresa y qué invitaciones hay pendientes. Los escribe
      // solo el servidor, que es el mismo que firma los claims del token: si el navegador pudiera
      // tocar esta lista, cambiar los módulos de uno mismo sería escribir un documento.
      //
      // El dueño los lee para su pantalla de usuarios. Un empleado no: la nómina de quién más
      // trabaja en la empresa, y con qué accesos, no es algo que necesite.
      match /miembros/{miembroUid} {
        allow read: if esElDueno(userId);
        allow write: if false;
      }

      match /invitaciones/{invitacionId} {
        allow read: if esElDueno(userId);
        allow write: if false;
      }

      // El registro del segundo factor (hash del código, intentos, dispositivos confiados). Lo
      // escribe y lo lee solo el servidor con el Admin SDK, que no pasa por estas reglas: si el
      // navegador pudiera tocarlo, se borraría los intentos fallidos o se agregaría su propio
      // dispositivo como confiado.
      match /seguridad/{documento} {
        allow read, write: if false;
      }
    }
  }
}
